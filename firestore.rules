rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return isRole('admin');
    }

    function isAgent() {
      return isRole('agent') || isAdmin();
    }

    function isPremiumUser(userId) {
      return exists(/databases/$(database)/documents/Users/$(userId))
        && (
          get(/databases/$(database)/documents/Users/$(userId)).data.role == 'premium'
          || get(/databases/$(database)/documents/Users/$(userId)).data.isPremiumActive == true
        );
    }

    function missingOrNull(field) {
      return !(field in request.resource.data) || request.resource.data[field] == null;
    }

    function missingOrDefault(field, value) {
      return !(field in request.resource.data) || request.resource.data[field] == value;
    }

    function missingOrEmptyList(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is list && request.resource.data[field].size() == 0);
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function userFields() {
      return [
        'id',
        'name',
        'email',
        'favouriteProductIds',
        'blockedUserIds',
        'role',
        'fcmToken',
        'languageCode',
        'profileImageUrl',
        'isAnonymous',
        'is2faEnabled',
        'isPremiumActive',
        'isSuspended',
        'premiumExpiresAt',
        'walletBalance'
      ];
    }

    function userSafeUpdateFields() {
      return [
        'name',
        'fcmToken',
        'languageCode',
        'profileImageUrl',
        'is2faEnabled',
        'favouriteProductIds',
        'blockedUserIds'
      ];
    }

    function validInitialUserRole() {
      return request.resource.data.role == 'user'
        || (
          request.resource.data.role == 'admin'
          && request.auth.token.email == request.resource.data.email
          && exists(/databases/$(database)/documents/AdminWhitelist/$(request.resource.data.email))
        );
    }

    function validOwnUserCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(userFields())
        && request.resource.data.keys().hasAll([
          'id',
          'name',
          'email',
          'role'
        ])
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && validInitialUserRole()
        && missingOrDefault('walletBalance', 0)
        && missingOrDefault('isPremiumActive', false)
        && missingOrDefault('isSuspended', false)
        && missingOrNull('premiumExpiresAt');
    }

    function validOwnUserUpdate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(userFields())
        && affectedKeys().hasOnly(userSafeUpdateFields())
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.walletBalance == resource.data.walletBalance
        && request.resource.data.isPremiumActive == resource.data.isPremiumActive
        && request.resource.data.premiumExpiresAt == resource.data.premiumExpiresAt
        && request.resource.data.isSuspended == resource.data.isSuspended
        && request.resource.data.isAnonymous == resource.data.isAnonymous;
    }

    function productFields() {
      return [
        'id',
        'title',
        'description',
        'category',
        'customCategory',
        'condition',
        'ownerId',
        'ownerName',
        'images',
        'createdAt',
        'updatedAt',
        'isAvailable',
        'tags',
        'location',
        'latitude',
        'longitude',
        'status',
        'viewCount',
        'interestedUsers',
        'viewedUserIds',
        'reportedByUserIds',
        'type',
        'serviceCategory',
        'customServiceCategory',
        'estimatedDuration',
        'priceRange',
        'availabilitySchedule',
        'skills',
        'duration',
        'availability',
        'transactionType',
        'price',
        'desiredSwapCategory',
        'isOwnerPremium',
        'needsReview',
        'reviewStatus',
        'aiScore',
        'aiCaption'
      ];
    }

    function productOwnerMutableFields() {
      return [
        'title',
        'description',
        'category',
        'customCategory',
        'condition',
        'ownerName',
        'images',
        'updatedAt',
        'isAvailable',
        'tags',
        'location',
        'latitude',
        'longitude',
        'status',
        'type',
        'serviceCategory',
        'customServiceCategory',
        'estimatedDuration',
        'priceRange',
        'availabilitySchedule',
        'skills',
        'duration',
        'availability',
        'transactionType',
        'price',
        'desiredSwapCategory'
      ];
    }

    function validProductCreate(productId) {
      return isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (
          !('id' in request.resource.data)
          || request.resource.data.id is string
        )
        && (
          !('isOwnerPremium' in request.resource.data)
          || request.resource.data.isOwnerPremium is bool
        )
        && (
          !('viewCount' in request.resource.data)
          || request.resource.data.viewCount is number
        )
        && (
          !('interestedUsers' in request.resource.data)
          || request.resource.data.interestedUsers is list
        )
        && (
          !('viewedUserIds' in request.resource.data)
          || request.resource.data.viewedUserIds is list
        )
        && (
          !('reportedByUserIds' in request.resource.data)
          || request.resource.data.reportedByUserIds is list
        )
        && (
          !('needsReview' in request.resource.data)
          || request.resource.data.needsReview is bool
        )
        && (
          !('reviewStatus' in request.resource.data)
          || request.resource.data.reviewStatus in ['pending', 'approved', 'rejected']
        )
        && (
          !('aiScore' in request.resource.data)
          || request.resource.data.aiScore == null
        )
        && (
          !('aiCaption' in request.resource.data)
          || request.resource.data.aiCaption == null
        );
    }

    function validOwnerProductUpdate() {
      return isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(productFields())
        && affectedKeys().hasOnly(productOwnerMutableFields())
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isOwnerPremium == resource.data.isOwnerPremium
        && request.resource.data.reportedByUserIds == resource.data.reportedByUserIds;
    }

    function addsSignedInUserTo(field) {
      return !(request.auth.uid in resource.data[field])
        && request.auth.uid in request.resource.data[field]
        && request.resource.data[field].size() == resource.data[field].size() + 1
        && request.resource.data[field].hasAll(resource.data[field]);
    }

    function removesSignedInUserFrom(field) {
      return request.auth.uid in resource.data[field]
        && !(request.auth.uid in request.resource.data[field])
        && request.resource.data[field].size() == resource.data[field].size() - 1
        && resource.data[field].hasAll(request.resource.data[field]);
    }

    function togglesSignedInUserIn(field) {
      return addsSignedInUserTo(field) || removesSignedInUserFrom(field);
    }

    function validProductViewUpdate() {
      return isSignedIn()
        && affectedKeys().hasOnly(['viewCount', 'viewedUserIds'])
        && addsSignedInUserTo('viewedUserIds')
        && request.resource.data.viewCount == resource.data.viewCount + 1;
    }

    function validProductInterestUpdate() {
      return isSignedIn()
        && affectedKeys().hasOnly(['interestedUsers'])
        && togglesSignedInUserIn('interestedUsers');
    }

    function validProductReportMarkerUpdate() {
      return isSignedIn()
        && affectedKeys().hasOnly(['reportedByUserIds', 'updatedAt'])
        && addsSignedInUserTo('reportedByUserIds');
    }

    function tradeFields() {
      return [
        'id',
        'fromUserId',
        'fromUserName',
        'toUserId',
        'toUserName',
        'offeredProductIds',
        'requestedProductIds',
        'message',
        'status',
        'type',
        'createdAt',
        'expiresAt',
        'updatedAt',
        'counterOffers',
        'isCounterOffer',
        'parentTradeId',
        'lastMessage',
        'lastMessageTime',
        'lastMessageSenderId',
        'hasUnreadMessages',
        'isFromPremium',
        'deliveryProvidedBy',
        'rejectionReason',
        'rejectedReason'
      ];
    }

    function tradeMutableFields() {
      return [
        'status',
        'updatedAt',
        'counterOffers',
        'deliveryProvidedBy',
        'lastMessage',
        'lastMessageTime',
        'lastMessageSenderId',
        'hasUnreadMessages',
        'rejectionReason',
        'rejectedReason'
      ];
    }

    function isTradeParticipantData(data) {
      return isSignedIn()
        && (data.fromUserId == request.auth.uid || data.toUserId == request.auth.uid);
    }

    function isTradeParticipant(tradeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Trades/$(tradeId))
        && (
          get(/databases/$(database)/documents/Trades/$(tradeId)).data.fromUserId == request.auth.uid
          || get(/databases/$(database)/documents/Trades/$(tradeId)).data.toUserId == request.auth.uid
        );
    }

    function validTradeCreate(tradeId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(tradeFields())
        && request.resource.data.keys().hasAll([
          'fromUserId',
          'toUserId'
        ])
        && missingOrDefault('id', tradeId)
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && missingOrDefault('status', 'pending')
        && missingOrDefault('isFromPremium', isPremiumUser(request.auth.uid))
        && missingOrEmptyList('deliveryProvidedBy');
    }

    function validTradeUpdate() {
      return isTradeParticipantData(resource.data)
        && request.resource.data.keys().hasOnly(tradeFields())
        && affectedKeys().hasOnly(tradeMutableFields())
        && request.resource.data.id == resource.data.id
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.offeredProductIds == resource.data.offeredProductIds
        && request.resource.data.requestedProductIds == resource.data.requestedProductIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isFromPremium == resource.data.isFromPremium;
    }

    function messageFields() {
      return [
        'id',
        'conversationId',
        'tradeId',
        'senderId',
        'content',
        'text',
        'imageUrl',
        'timestamp',
        'isRead',
        'readAt'
      ];
    }

    function validMessageCreate(messageId) {
      return isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && (
          !('id' in request.resource.data)
          || request.resource.data.id is string
        )
        && (
          !('isRead' in request.resource.data)
          || request.resource.data.isRead is bool
        );
    }

    function validMessageReadUpdate() {
      return isSignedIn()
        && affectedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.senderId == resource.data.senderId;
    }

    function isConversationParticipantData(data) {
      return isSignedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/Conversations/$(conversationId)).data.participants;
    }

    function otherConversationParticipant(data) {
      return data.participants[0] == request.auth.uid
        ? data.participants[1]
        : data.participants[0];
    }

    function conversationMutableFields(data) {
      return [
        'updatedAt',
        'lastMessage',
        'lastMessageTime',
        'lastMessageSenderId',
        'unreadCount_' + request.auth.uid,
        'unreadCount_' + otherConversationParticipant(data)
      ];
    }

    function validConversationCreate(conversationId) {
      return isSignedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && (
          !('id' in request.resource.data)
          || request.resource.data.id is string
        );
    }

    function validConversationUpdate() {
      return isSignedIn()
        && (
          isConversationParticipantData(resource.data)
          || isAdmin()
        )
        && (
          !('participants' in resource.data)
          || request.resource.data.participants == resource.data.participants
        )
        && (
          !('id' in resource.data)
          || request.resource.data.id == resource.data.id
        )
        && (
          !('createdAt' in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt
        );
    }

    function notificationFields() {
      return [
        'id',
        'userId',
        'title',
        'body',
        'type',
        'relatedId',
        'isRead',
        'createdAt',
        'readAt'
      ];
    }

    function validNotificationCreate(notificationId) {
      return request.resource.data.keys().hasOnly(notificationFields())
        && request.resource.data.id == notificationId
        && request.resource.data.userId is string
        && request.resource.data.isRead == false;
    }

    function validOwnNotificationReadUpdate() {
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && affectedKeys().hasOnly(['isRead', 'readAt']);
    }

    function paymentFields() {
      return [
        'id',
        'buyerId',
        'buyerName',
        'sellerId',
        'productId',
        'productTitle',
        'amount',
        'currency',
        'transactionId',
        'status',
        'createdAt',
        'completedAt',
        'paymobOrderId'
      ];
    }

    function validPaymentCreate(paymentId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(paymentFields())
        && request.resource.data.id == paymentId
        && request.resource.data.buyerId == request.auth.uid
        && (
          request.resource.data.status == 'pending'
          || request.resource.data.status == 'completed'
        );
    }

    function validPremiumPaymentCreate(paymentId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(paymentFields())
        && request.resource.data.id == paymentId
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId == 'barter_premium'
        && request.resource.data.productId == 'premium_subscription'
        && request.resource.data.status == 'completed';
    }

    function withdrawalFields() {
      return [
        'id',
        'sellerId',
        'sellerName',
        'amount',
        'bankDetails',
        'status',
        'createdAt',
        'updatedAt'
      ];
    }

    function premiumSubscriptionFields() {
      return [
        'userId',
        'plan',
        'startedAt',
        'expiresAt',
        'transactionId',
        'amountPaid',
        'currency'
      ];
    }

    function reportFields() {
      return [
        'id',
        'reporterId',
        'reporterName',
        'reportedProductId',
        'reportedProductTitle',
        'reportedProductOwnerId',
        'reason',
        'description',
        'status',
        'createdAt',
        'reviewedAt',
        'adminNote'
      ];
    }

    match /Users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || validOwnUserCreate(userId);
      allow update: if isAdmin() || validOwnUserUpdate(userId);
      allow delete: if isAdmin();

      match /Reviews/{reviewId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /Products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || validProductCreate(productId);
      allow update: if isAdmin()
        || validOwnerProductUpdate()
        || validProductViewUpdate()
        || validProductInterestUpdate()
        // TODO: move this denormalized report marker to Cloud Functions.
        || validProductReportMarkerUpdate();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /Trades/{tradeId} {
      allow read: if isAdmin() || isTradeParticipantData(resource.data);
      allow create: if isAdmin() || validTradeCreate(tradeId);
      allow update: if isAdmin() || validTradeUpdate();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isTradeParticipant(tradeId);
        allow create: if (isAdmin() || isTradeParticipant(tradeId))
          && validMessageCreate(messageId);
        allow update: if isAdmin()
          || (isTradeParticipant(tradeId) && validMessageReadUpdate());
        allow delete: if isAdmin();
      }

      match /Messages/{messageId} {
        allow read: if isAdmin() || isTradeParticipant(tradeId);
        allow create: if (isAdmin() || isTradeParticipant(tradeId))
          && validMessageCreate(messageId);
        allow update: if isAdmin()
          || (isTradeParticipant(tradeId) && validMessageReadUpdate());
        allow delete: if isAdmin();
      }
    }

    match /TradeHistory/{historyId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.tradeId is string
          && isTradeParticipant(resource.data.tradeId)
        );
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'tradeId',
          'action',
          'performedByUserId',
          'performedByUserName',
          'timestamp',
          'details'
        ])
        && request.resource.data.id == historyId
        && request.resource.data.tradeId is string
        && request.resource.data.performedByUserId == request.auth.uid
        && isTradeParticipant(request.resource.data.tradeId);
      allow update, delete: if isAdmin();
    }

    match /Conversations/{conversationId} {
      // TODO: Move to participant-only read after verifying all conversation queries use participants array-contains auth.uid.
      allow read: if isSignedIn();
      allow create: if isAdmin() || validConversationCreate(conversationId);
      allow update: if isAdmin() || validConversationUpdate();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // TODO: Restrict message read to conversation participants after verifying existing conversation documents always contain participants.
        allow read: if isSignedIn();
        allow create: if (isAdmin() || isConversationParticipant(conversationId))
          && validMessageCreate(messageId)
          && request.resource.data.conversationId == conversationId;
        allow update: if isAdmin()
          || (isConversationParticipant(conversationId) && validMessageReadUpdate());
        allow delete: if isAdmin();
      }

      match /Messages/{messageId} {
        // TODO: Restrict message read to conversation participants after verifying existing conversation documents always contain participants.
        allow read: if isSignedIn();
        allow create: if (isAdmin() || isConversationParticipant(conversationId))
          && validMessageCreate(messageId)
          && request.resource.data.conversationId == conversationId;
        allow update: if isAdmin()
          || (isConversationParticipant(conversationId) && validMessageReadUpdate());
        allow delete: if isAdmin();
      }
    }

    match /Notifications/{notificationId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      // TODO: move notification creation to Cloud Functions. The current app
      // creates in-app notifications from client-side trade/chat/report flows.
      allow create: if isAdmin()
        || (isSignedIn() && validNotificationCreate(notificationId));
      allow update: if isAdmin() || validOwnNotificationReadUpdate();
      allow delete: if isAdmin();
    }

    match /Reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(reportFields())
        && request.resource.data.id == reportId
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && missingOrNull('reviewedAt')
        && missingOrNull('adminNote');
      allow update, delete: if isAdmin();
    }

    match /Payments/{paymentId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)
        );
      // TODO: move payment verification/completion to a Paymob webhook Cloud Function.
      allow create: if validPaymentCreate(paymentId) || validPremiumPaymentCreate(paymentId);
      allow update, delete: if isAdmin();
    }

    match /WalletTransactions/{transactionId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /WithdrawalRequests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(withdrawalFields())
        && request.resource.data.id == requestId
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /PremiumSubscriptions/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      // TODO: move premium activation to Cloud Functions. Kept temporarily
      // because the current Flutter premium flow writes this document directly.
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(premiumSubscriptionFields())
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.plan == 'monthly';
      allow delete: if isAdmin();
    }

    match /AdminWhitelist/{email} {
      allow read, write: if isAdmin();
    }

    match /ApprovedCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /CategorySuggestions/{suggestionId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'suggestedName',
          'suggestedBy',
          'suggestedByName',
          'status',
          'createdAt',
          'reviewedBy',
          'reviewedByName',
          'reviewedAt'
        ])
        && request.resource.data.id == suggestionId
        && request.resource.data.suggestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && missingOrNull('reviewedBy')
        && missingOrNull('reviewedByName')
        && missingOrNull('reviewedAt');
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'reviewerId',
          'reviewerName',
          'targetUserId',
          'rating',
          'comment',
          'createdAt',
          'tradeId'
        ])
        && request.resource.data.id == reviewId
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.reviewerId != request.resource.data.targetUserId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow read: if isAdmin()
        || isAgent()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId',
          'agentId',
          'itemName',
          'fullName',
          'phoneNumber',
          'address',
          'status',
          'tradeId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && missingOrNull('agentId');
      allow update: if isAgent()
        && affectedKeys().hasOnly(['status', 'agentId', 'updatedAt'])
        && request.resource.data.agentId == request.auth.uid
        && (!('agentId' in resource.data) || resource.data.agentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
